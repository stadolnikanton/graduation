# ===== PostgreSQL =====
POSTGRES_DB=filecloud
POSTGRES_USER=filecloud_user
POSTGRES_PASSWORD=filecloud_password
DB_PORT=5432

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PORT_EXTERNAL=6379

# ===== MinIO =====
MINIO_ENDPOINT=minio
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_BUCKET_NAME=uploads

# ===== JWT =====
SECRET_KEY=super_secret_dev_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Backend =====
BACKEND_PORT=8000

# ===== File Size Limits (bytes) =====
MAX_FILE_SIZE=104857600        # 100 MB
MAX_TOTAL_SIZE=524288000       # 500 MB
